---
import Head from '@components/Head.astro';
import '@styles/global.css';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Head title={title} />
  </head>
  <body>
    <slot />
  </body>
</html>
