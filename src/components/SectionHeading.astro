---
interface Props {
  eyebrow: string;
  detail?: string;
}

const { eyebrow, detail } = Astro.props;
---

<div class="heading">
  <span>{eyebrow}</span>
  {detail && <span>{detail}</span>}
</div>

<style>
  .heading {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }
</style>
