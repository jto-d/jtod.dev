---
import AtmosphereField from '@components/AtmosphereField.astro';
import Topbar from '@components/Topbar.astro';
import { profile } from '@data/site';

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
const [roleFirst, ...roleRest] = profile.role.split(' ');
---

<header class="hero">
  <AtmosphereField />
  <Topbar />

  <div class="display-left">
    <h1>{firstName.toUpperCase()}<br />{lastName.toUpperCase()}</h1>
    <p class="meta">
      Based in {profile.location}<br />
      Building since {profile.buildingSince}
    </p>
  </div>
  <div class="availability">Available for &nbsp;&nbsp; Select work</div>

  <div class="display-right">
    <h2>{roleFirst.toUpperCase()}<br />{roleRest.join(' ').toUpperCase()}</h2>
    <p class="meta">
      Infrastructure<br />
      &amp; Developer<br />
      Tooling
    </p>
  </div>

  <div class="display-center">Systems<br />Tooling<br />Reliability</div>

  <div class="stat stat-left">
    Ten years<br />Shipping software
    <div class="stat-value">Since {profile.buildingSince}</div>
  </div>
  <div class="hint">Selected work<br />Below</div>

  <div class="stat stat-right">
    Open to talk about<br />Infra &amp; tooling
    <div class="stat-value">{profile.location}</div>
  </div>

  <div class="footer-labels">
    <span>{profile.location}</span>
    <span class="muted">Selected work &darr;</span>
    <span>Est. {profile.buildingSince}</span>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 940px;
    overflow: hidden;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
    margin: 0;
  }

  .meta {
    margin: 26px 0 0;
    font-size: 13px;
    letter-spacing: 0.14em;
    color: var(--color-text-secondary);
    line-height: 2;
  }

  .display-left {
    position: absolute;
    top: 210px;
    left: var(--section-padding-x);
  }

  .display-left h1 {
    font-size: 74px;
    line-height: 0.9;
  }

  .availability {
    position: absolute;
    top: 214px;
    left: 56%;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--color-text-muted);
  }

  .display-right {
    position: absolute;
    top: 330px;
    right: var(--section-padding-x);
    text-align: right;
  }

  .display-right h2 {
    font-size: 56px;
    letter-spacing: -0.01em;
    line-height: 0.95;
  }

  .display-right .meta {
    line-height: 2.1;
  }

  .display-center {
    position: absolute;
    top: 474px;
    left: 40%;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--color-text-quaternary);
    line-height: 2.4;
  }

  .stat {
    position: absolute;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-text-quaternary);
    line-height: 2;
  }

  .stat-left {
    bottom: 150px;
    left: var(--section-padding-x);
  }

  .stat-right {
    bottom: 150px;
    right: var(--section-padding-x);
    text-align: right;
  }

  .stat-value {
    margin-top: 8px;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .hint {
    position: absolute;
    bottom: 158px;
    left: 32%;
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--color-text-tertiary);
    line-height: 1.9;
  }

  .footer-labels {
    position: absolute;
    bottom: 52px;
    left: var(--section-padding-x);
    right: var(--section-padding-x);
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-text-secondary);
  }

  .footer-labels .muted {
    opacity: 0.7;
  }
</style>
