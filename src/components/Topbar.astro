---
import { navLinks, profile } from '@data/site';

const [firstName, ...rest] = profile.name.split(' ');
const lastName = rest.join(' ');
---

<nav class="topbar">
  <div class="identity">
    <span class="wordmark"><span class="accent">{firstName.toUpperCase()}</span> {lastName.toUpperCase()}</span>
    <span class="role">Software<br />Engineer</span>
    <span class="tagline">{profile.tagline.toUpperCase()}</span>
  </div>
  <div class="links">
    {navLinks.map((link) => <a href={link.href}>{link.label.toUpperCase()}</a>)}
  </div>
</nav>

<style>
  .topbar {
    position: absolute;
    top: 44px;
    left: var(--section-padding-x);
    right: var(--section-padding-x);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .identity {
    display: flex;
    gap: 40px;
    align-items: flex-start;
  }

  .wordmark .accent {
    color: var(--color-accent);
    font-weight: 600;
  }

  .tagline {
    max-width: 180px;
    opacity: 0.7;
  }

  .links {
    display: flex;
    gap: 26px;
  }

  .links a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .links a:hover {
    color: var(--color-accent);
  }
</style>
